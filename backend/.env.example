# Environment variables for Nexus RAG Backend
# Copy this file to .env and fill in your actual values

# ── LLM (Groq) ──────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
PORT=3001
API_KEY=                        # Optional: set to enable API key auth (leave blank for dev mode)
LLM_MODEL=llama-3.1-8b-instant

# ── Embeddings ───────────────────────────────────────────────────────────────
# Runs locally via @xenova/transformers — no API key needed
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Local:      http://localhost:8001
# Production: Use the internal Render URL, e.g. http://nexus-rag-chroma:8000
CHROMA_URL=http://localhost:8001
CHROMA_COLLECTION=research_papers

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# In production, set to your Vercel frontend URL
CORS_ORIGIN=http://localhost:5173

# ── RAG Pipeline ─────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
RERANK_TOP_K=3
MAX_FILE_SIZE_MB=50
