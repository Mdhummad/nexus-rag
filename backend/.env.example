# Environment variables for Nexus RAG Backend
# Copy this file to .env and fill in your actual values

# ── LLM (Groq) ──────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
LLM_MODEL=llama-3.1-8b-instant

# ── Embeddings ───────────────────────────────────────────────────────────────
# Runs locally via @xenova/transformers — no API key needed
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# ── Qdrant Cloud (Vector Database) ──────────────────────────────────────────
# Sign up FREE at https://cloud.qdrant.io — no credit card needed
# Cloud URL format: https://<cluster-id>.<region>.cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.us-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=research_papers

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# In production, set to your Vercel frontend URL
CORS_ORIGIN=http://localhost:5173

# ── API Key Auth (optional) ──────────────────────────────────────────────────
# Leave blank in dev mode — set in production to secure your API
API_KEY=

# ── RAG Pipeline ─────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
RERANK_TOP_K=3
MAX_FILE_SIZE_MB=50
